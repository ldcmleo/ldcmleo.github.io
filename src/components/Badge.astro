---
import type { BadgeItem } from "../data/badges";

interface Props {
    data: BadgeItem;
    lang?: "es" | "en";
}

const { data, lang = "es" } = Astro.props;
---
<article class="group md:flex border-b border-[#a9b4c6] dark:border-zinc-800 border-dashed transition-colors duration-150">
    <div class="min-w-[170px] border-b md:border-b-0 md:border-r border-[#a9b4c6] dark:border-zinc-800 border-dashed p-4 flex flex-row md:flex-col items-center md:items-start justify-between md:justify-start gap-3">
        <span class="text-sm font-medium tracking-tight text-zinc-600 dark:text-zinc-400">{ data.date }</span>
        {data.imageUrl && (
            <div class="w-16 h-16 sm:w-20 sm:h-20 shrink-0 flex items-center justify-center p-1 bg-white/60 dark:bg-zinc-900/60 rounded border border-[#a9b4c6]/30 dark:border-zinc-800/80 shadow-xs">
                <img
                    src={data.imageUrl}
                    alt={data.title}
                    width="80"
                    height="80"
                    loading="lazy"
                    class="w-full h-full object-contain drop-shadow-sm transition-transform duration-200 ease-out group-hover:scale-105"
                />
            </div>
        )}
    </div>
    <div class="flex flex-col flex-1 justify-between p-4 space-y-3">
        <div>
            <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-100 tracking-tight">
                    <a
                        class="inline-flex items-center gap-1.5 hover:text-teal-700 dark:hover:text-teal-400 hover:underline active:scale-[0.99] transition-all duration-150 ease-[cubic-bezier(0.23,1,0.32,1)]"
                        target="_blank"
                        rel="noopener noreferrer"
                        href={ data.badgeUrl }
                    >
                        <span>{ data.title }</span>
                        <i class="nf nf-fa-external_link text-xs opacity-70"></i>
                    </a>
                </h3>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 text-[11px] font-mono font-medium rounded-sm bg-teal-500/10 text-teal-800 dark:text-teal-300 border border-teal-600/30">
                    <i class="nf nf-fa-check_circle text-[10px]"></i>
                    <span>{lang === "en" ? "Credly Verified" : "Verificado en Credly"}</span>
                </span>
            </div>
            <div class="pt-1">
                <p class="font-semibold text-sm text-zinc-700 dark:text-zinc-300">{ data.issuer }</p>
            </div>
            {data.description && (
                <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed pt-2">
                    { data.description }
                </p>
            )}
        </div>
        {data.skills.length > 0 && (
            <div class="flex flex-wrap gap-1.5 pt-1">
                {data.skills.map((skill: string) => (
                    <span class="font-mono text-xs px-2.5 py-1 bg-zinc-200/70 dark:bg-zinc-800/70 text-zinc-700 dark:text-zinc-300 border border-[#a9b4c6]/40 dark:border-zinc-700/50">
                        {skill}
                    </span>
                ))}
            </div>
        )}
        <div class="pt-1">
            <a
                href={data.badgeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-xs font-mono text-teal-700 dark:text-teal-400 hover:underline active:scale-95 transition-all duration-150 ease-[cubic-bezier(0.23,1,0.32,1)]"
            >
                <span>{lang === "en" ? "View digital badge on Credly" : "Ver insignia digital en Credly"}</span>
                <i class="nf nf-fa-external_link text-[10px]"></i>
            </a>
        </div>
    </div>
</article>
