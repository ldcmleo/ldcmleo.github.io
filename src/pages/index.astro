            { name: "HTML", icon: "nf-dev-html5", color: "#E34F26" },
            { name: "css", icon: "nf-dev-css3", color: "#1572B6"}
        ]
    },
    {
        id: "project1",
        role: "Desarrollador de Aplicaciones Web",
        time: "2024 - 2025",
        location: "Reynosa, Tamaulipas, México",
        at: {
